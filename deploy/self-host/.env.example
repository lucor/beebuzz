# Public base domain. Create dashboard, hive, and api DNS records for this domain.
BEEBUZZ_DOMAIN=example.com

# caddy_auto obtains public certificates. caddy_lancert uses certificates from Lancert.
BEEBUZZ_CADDY_CONFIG=caddy_auto
# BEEBUZZ_CERTS_DIR=/absolute/path/to/lancert/certs/example.lancert.dev

# Email address promoted to administrator after its first successful sign-in.
BEEBUZZ_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Random secrets. See the self-hosting guide for generation commands.
BEEBUZZ_IP_HASH_SALT=
BEEBUZZ_VAPID_PRIVATE_KEY=
BEEBUZZ_VAPID_PUBLIC_KEY=

# Outbound email is required for one-time-password sign-in.
BEEBUZZ_MAILER_SENDER=noreply@example.com
BEEBUZZ_MAILER_REPLY_TO=support@example.com
BEEBUZZ_MAILER_SMTP_ADDRESS=smtp.example.com:587
BEEBUZZ_MAILER_SMTP_USER=
BEEBUZZ_MAILER_SMTP_PASSWORD=

# Alternatively, remove the SMTP settings above and provide a Resend API key.
# BEEBUZZ_MAILER_RESEND_API_KEY=

# For local testing with the Compose Mailpit profile, use these instead:
# BEEBUZZ_MAILER_SMTP_ADDRESS=mailpit:1025
# BEEBUZZ_MAILER_SMTP_USER=dev
# BEEBUZZ_MAILER_SMTP_PASSWORD=dev
