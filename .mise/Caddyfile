{$BEEBUZZ_DOMAIN} {
	tls "{$BEEBUZZ_TLS_CERT_FILE}" "{$BEEBUZZ_TLS_KEY_FILE}"

	redir https://dashboard.{$BEEBUZZ_DOMAIN}{uri} 301
}

dashboard.{$BEEBUZZ_DOMAIN} {
	tls "{$BEEBUZZ_TLS_CERT_FILE}" "{$BEEBUZZ_TLS_KEY_FILE}"

	reverse_proxy localhost:5173
}

api.{$BEEBUZZ_DOMAIN} {
	tls "{$BEEBUZZ_TLS_CERT_FILE}" "{$BEEBUZZ_TLS_KEY_FILE}"
	reverse_proxy localhost:8899
}

hive.{$BEEBUZZ_DOMAIN} {
	tls "{$BEEBUZZ_TLS_CERT_FILE}" "{$BEEBUZZ_TLS_KEY_FILE}"
	reverse_proxy localhost:5174
}

push.{$BEEBUZZ_DOMAIN} {
	tls "{$BEEBUZZ_TLS_CERT_FILE}" "{$BEEBUZZ_TLS_KEY_FILE}"
	reverse_proxy localhost:8899
}

hook.{$BEEBUZZ_DOMAIN} {
	tls "{$BEEBUZZ_TLS_CERT_FILE}" "{$BEEBUZZ_TLS_KEY_FILE}"
	reverse_proxy localhost:8899
}
